# RBQ 시뮬레이션 스택(bin/Motion, bin/Network, bin/Mujoco, bin/GUI) 실행용 런타임 이미지.
#
# 왜 22.04인가:
#   RBQ 레포의 bin/* 바이너리는 Ubuntu 22.04에서 빌드됐다. 개발 머신(24.04)에서는
#   libicu70 / libopencv 4.5d 가 없어 실행되지 않는다. camel 본체는 24.04(Jazzy)를
#   그대로 쓰고, 이 컨테이너는 "로봇 역할"만 담당한다.
#
# 빌드용이 아니라 실행 전용이다. -dev 패키지를 넣지 않는다.
# 패키지 목록은 objdump -p bin/* | grep NEEDED 의 직접 의존만 커버한다.
#
# CycloneDDS(libddsc/libddscxx)와 librbq_sdk는 bin/ 안에 동봉돼 있고
# 바이너리 RUNPATH가 $ORIGIN이라 컨테이너에 별도 설치하지 않는다.
# ⚠️ 이 이미지에 CycloneDDS를 따로 설치하지 말 것 — soname 충돌로 힙 손상이 난다.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        # 스크립트가 쓰는 것 (start_*.bash: pgrep, sudo ./Motion, gnome-terminal)
        sudo procps dbus-x11 gnome-terminal ca-certificates \
        # Network 가 링크 헬스체크로 ping 바이너리를 호출한다.
        # 없으면 "[Network] ping failed: 127.0.0.1" 이 1초마다 찍히고
        # GUI 가 LAN 핸드셰이크를 못 끝내 auto-reconnect 루프에 빠진다.
        iputils-ping \
        # 공통 (Motion / Network / Mujoco / GUI 전부)
        libicu70 \
        # Mujoco
        libglfw3 libopencv-imgcodecs4.5d libopencv-imgproc4.5d libopencv-core4.5d \
        # GUI - SDL2 / 렌더링
        libsdl2-2.0-0 libegl1 libgl1 libglx-mesa0 libgl1-mesa-dri libgbm1 libdrm2 \
        libwayland-client0 libwayland-cursor0 libwayland-egl1 \
        # GUI - xcb 계열
        libx11-6 libx11-xcb1 libxcb1 libxcb-glx0 libxcb-icccm4 libxcb-image0 \
        libxcb-keysyms1 libxcb-randr0 libxcb-render0 libxcb-render-util0 \
        libxcb-shape0 libxcb-shm0 libxcb-sync1 libxcb-xfixes0 libxcb-xinerama0 \
        libxcb-xinput0 libxcb-xkb1 \
        libxkbcommon0 libxkbcommon-x11-0 libxcomposite1 libsm6 libice6 \
        # GUI - 폰트 / 이미지
        libfontconfig1 libfreetype6 libwebp7 libwebpdemux2 libwebpmux3 \
    && rm -rf /var/lib/apt/lists/*

# --- GPU 가속에 관하여 ---
#
# 22.04 기본 Mesa(23.2)는 Intel Arrow Lake-P [8086:7dd1] 를 모른다:
#   MESA: warning: Driver does not support the 0x7dd1 PCI ID.
#   libGL error: failed to load driver: iris
#   → Device: llvmpipe  (순수 소프트웨어 렌더링)
# Mujoco 뷰포트가 끊기고, CPU를 잡아먹어 RT 스레드 deadline 경고까지 유발한다.
#
# kisak-mesa PPA 는 해결책이 아니다 — jammy 저장소가 비어 있다
# (InRelease 만 있고 Packages 인덱스가 없어 apt 가 가져올 패키지가 없음).
#
# 대신 NVIDIA dGPU 를 쓴다. nvidia-container-toolkit 이 드라이버 유저스페이스를
# 컨테이너에 주입하므로 Mesa 버전과 무관해진다. 호스트에서 1회 준비:
#   sudo apt install nvidia-container-toolkit
#   sudo nvidia-ctk runtime configure --runtime=docker && sudo systemctl restart docker
# 그 뒤 rbq_sim.sh 가 --gpus all 을 자동으로 붙인다.
#
# libgl1/libegl1(=libglvnd)은 위에서 이미 설치했다. NVIDIA 드라이버가
# libGLX_nvidia.so 를 주입하면 glvnd 가 그쪽으로 디스패치한다.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=graphics,display,compute,utility

# ⚠️ sudo 는 기본적으로 환경을 초기화한다(env_reset).
# start_*.bash 가 `sudo ./Mujoco` 로 앱을 띄우므로, 위 GL 변수들이 그대로 날아가
# glvnd 가 NVIDIA 로 디스패치하지 못하고 Mesa→iris(Arrow Lake 미지원)→llvmpipe
# 소프트웨어 렌더링으로 떨어진다. 이게 "Mujoco 렉"의 실제 원인이었다.
# (rcl 시절 sudo 가 LD_LIBRARY_PATH 를 날려 ROS 라이브러리를 못 찾던 것과 같은 부류.)
#
# ⚠️ use_pty 는 Ctrl+C 를 삼킨다.
# 우분투 기본 sudoers 의 `Defaults use_pty` 는 sudo 가 명령을 **별도 pty + 별도
# 세션**에서 돌리게 한다. 그러면 터미널의 Ctrl+C 가 그 안쪽 pty 로만 들어가서,
# 바깥 프로세스 그룹(rbq_sim.sh 의 래퍼 셸, 벤더 워치독 루프)은 SIGINT 를 아예
# 못 받는다. 래퍼가 트랩을 걸어 놔도 발동하지 않아 앱이 안 꺼진다.
# 실측: use_pty 상태에서는 Ctrl+C 후에도 Sim FPS 가 계속 찍히고, !use_pty 로
# 바꾸면 즉시 트랩이 돌아 정상 종료된다.
# use_pty 는 신뢰 못 할 사용자의 TTY 하이재킹을 막는 장치인데, 이 컨테이너는
# 개발용 sim 이고 어차피 root 로 도므로 얻는 게 없다.
RUN printf '%s\n' \
    'Defaults env_keep += "DISPLAY XAUTHORITY"' \
    'Defaults env_keep += "__GLX_VENDOR_LIBRARY_NAME __NV_PRIME_RENDER_OFFLOAD"' \
    'Defaults env_keep += "NVIDIA_VISIBLE_DEVICES NVIDIA_DRIVER_CAPABILITIES"' \
    'Defaults !use_pty' \
    > /etc/sudoers.d/gl-env \
    && chmod 0440 /etc/sudoers.d/gl-env

# 호스트 사용자와 uid를 맞춰 마운트한 RBQ 레포에 로그를 쓸 수 있게 한다.
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} rbq 2>/dev/null || true && \
    useradd -m -u ${UID} -g ${GID} -s /bin/bash rbq 2>/dev/null || true && \
    echo "rbq ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/rbq && \
    chmod 0440 /etc/sudoers.d/rbq

WORKDIR /workspace/RBQ
CMD ["/bin/bash"]
