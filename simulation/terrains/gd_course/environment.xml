        <!-- 2026-09-15: 기존 보행로(y=[-1.25,1.25], pyr_stair1 만 y=±2.1 로 더 넓음)
             옆에 폭 3m짜리 평평한 직선 시험 보행로를 붙였다. 자꾸 넘어지는 구간(마찰
             구간, 계단, 산악지형, 갭 등)을 매번 처음부터 다시 통과하지 않고도, 이
             평평한 레인을 곧장 걸어가서 원하는 x 지점에서 옆으로(-y) 이동해 실제
             보행로에 진입해 그 구간만 테스트할 수 있게 하기 위함. 바깥쪽 가드월을
             그만큼 밀어내고(guard_wall_pos_y, 1.26->4.28) 그 사이를 flat_test_lane
             으로 채웠다. 안쪽 경계(y=1.26)엔 벽이 없어서 자유롭게 옆으로 넘나든다.
             pyr_stair1(x=9.6-13.8)의 outermost 계단(top z=0.15)이 이 레인의 안쪽
             일부(y=1.26-2.1)와 지하로 겹치는데, 둘 다 정적 지오메트리라 물리적으로
             무해하고, 그 구간만 지표면이 pyr_stair1 쪽으로 15cm 정도 얕게 걸린다. -->
        <geom name="guard_wall_pos_y" type="box" pos="23.300 4.280 0" size="25.300 0.020 3.000"
              rgba="0.7 0.85 1.0 0.15" contype="1" conaffinity="1"/>
        <geom name="guard_wall_neg_y" type="box" pos="23.300 -1.260 0" size="25.300 0.020 3.000"
              rgba="0.7 0.85 1.0 0.15" contype="1" conaffinity="1"/>
        <!-- 2026-09-15: 시작 지점(start_pad, x=[-2.0,0.6]) 뒤로 후진하면 guard wall이
             옆(y)만 막고 뒤(-x)는 안 막아서 그대로 코스 밖으로 떨어짐. 옆벽과 같은
             스타일의 투명 마감벽을 시작 지점 바로 뒤에 추가. -->
        <geom name="start_wall_neg_x" type="box" pos="-2.050 1.510 0" size="0.020 2.770 3.000"
              rgba="0.7 0.85 1.0 0.15" contype="1" conaffinity="1"/>
        <!-- flat_test_lane 을 두 조각으로 나눴다: a 는 y=0 구간(마찰/피라미드/계단전환
             까지), b 는 ramp_up 을 넘어간 뒤의 높은 구간(z=1.1, gap_run/mountain
             진입부와 같은 높이. 갭 구간까지 평평하게 이어서 갈 수 있음).
             그 사이(x=16.9-20.4)는 아래에서 폭을 넓힌 ramp_up 자체가 레인의
             경사 연결부를 겸한다. 44.1m 이후(마지막 오르내리는 계단, landing_end)는
             또 다른 높이라 아직 이 레인이 안 이어짐. 필요하면 세그먼트 추가 가능. -->
        <geom name="flat_test_lane_a" class="obstacle" type="box" pos="7.400 2.760 -1.500" size="9.400 1.500 1.500"
              rgba="0.55 0.75 0.55 1"/>
