# Lab topology for the split setup. Pilot resolves the robot address from here;
# the sim container defaults to lo and only needs CONTROLLER_HOST=<ip> when
# Pilot runs on another machine.
#
#   192.168.0.10   robot side   docker/rbq_sim.sh motion + mujoco, or the real
#                               robot — the vendor's r-pc, which we only call
#   192.168.0.12   pilot        CAMEL-Pilot — DDS to the robot, console socket to the operator
#   192.168.0.4    console      no DDS; finds Pilot over the UDP beacon
#
# Addresses are resolved through the routing table, so one this host owns comes
# back as "lo" and the everything-on-one-box setup keeps working without
# changing anything here.
#
# Per-run override, no edit needed:
#   CONTROLLER_HOST=<ip> bash docker/rbq_sim.sh motion
#   RBQ_SDK_IFACE=<nic>  ./build/pilot/CAMEL-Pilot          (or --interface <nic>)
#
# Sourced by shell scripts, so keep this to plain KEY=value with no spaces.

# Where the robot (or the sim standing in for it) lives, as seen from Pilot.
RBQ_ROBOT_HOST_DEFAULT=192.168.0.10
