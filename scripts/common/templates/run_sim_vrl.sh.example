#!/usr/bin/env bash
# New VRL model launchers must delegate lifecycle to scripts/run_sim_vrl.sh.
# Copy into <method>/run_sim.sh, set the exact policy path, chmod 755, then run
# python3 -m unittest discover -s tests -p 'test_sim_launchers.py'.
# For a deeper deployment directory, adjust the repository-root traversal.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[[ $# -le 1 ]] || { echo "Usage: $0 [stop|--check]" >&2; exit 2; }
case "${1:-}" in ''|stop|--check) ;; *) exit 2 ;; esac
export RBQ_POLICY_FILE='REPLACE_WITH_METHOD/MODEL/policy_vrl.onnx'
export RBQ_WALK=ours RBQ_SIM_VISION=1 RBQ_SIM_SYNC_VISION=1
# Do not duplicate terminal creation, process killing, or window cleanup here.
exec bash "$repo_root/scripts/run_sim_vrl.sh" "$@"
